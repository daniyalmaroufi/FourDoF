<package format="2">
  <name>fourdof</name>
  <version>0.0.0</version>
  <description>ROS1 control package for the 4-DOF robot (ITR/OTR rotational, ITT/OTT translational)</description>
  <maintainer email="maroufi@utexas.edu">Daniyal Maroufi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>message_generation</build_depend>
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Required by libs/dynamixel_easy_sdk (connector.py) but previously undeclared here -->
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>dynamixel_sdk</exec_depend>

</package>
